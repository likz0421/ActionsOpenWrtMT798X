CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_KERNEL_TCP_FASTOPEN=y
CONFIG_KERNEL_NET_NS=y

# =========================================================
# LuCI 主题 (浅色)
# =========================================================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# =========================================================
# 防火墙 UI (基础组件)
# =========================================================
CONFIG_PACKAGE_luci-app-firewall=y

# =========================================================
# 网络共享默认关闭
# =========================================================
CONFIG_PACKAGE_autosamba=n
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_luci-app-cifs-mount=n

# =========================================================
# Lucky (官方 release.66666.host 3.3.3 xiaojv 预编译静态二进制)
# 由 25.12/diy-part1-min.sh 注入 package/custom/lucky-app/lucky
# =========================================================
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y

# =========================================================
# UPnP (miniupnpd + LuCI)
# =========================================================
CONFIG_PACKAGE_luci-app-upnp=y

# =========================================================
# 琉璃 Liuli 主题 & 看板 (编入固件, 刷完即自带)
# =========================================================
CONFIG_PACKAGE_luci-theme-liuli=y
CONFIG_PACKAGE_luci-app-liuli=y
