{#
	琉璃 Liuli — LuCI glassmorphism theme
	Main page shell: frosted topbar with live status chips + glass sidenav.
-#}

{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board');
	const hostname = striptags(boardinfo?.hostname ?? '?');
	const model = striptags(boardinfo?.model ?? '');
	const sysinfo = ubus.call('system', 'info') ?? {};

	const uptime = sysinfo.uptime ?? 0;
	const d = int(uptime / 86400);
	const h = int((uptime % 86400) / 3600);
	const m = int((uptime % 3600) / 60);
	const pad = (n) => (n < 10 ? `0${n}` : `${n}`);
	const uptime_str = `${d ? `${d}天 ` : ''}${pad(h)}:${pad(m)}`;

	const distver = version?.distversion ?? '';

	include('themes/' + theme + '/head', { hostname: hostname, is_login: false });
%}

<body class="lang_{{ dispatcher.lang }} {{ node?.title ? ` - ${striptags(node.title)}` : '' }} {% if (ctx.authsession): %}logged-in{% endif %}"
	data-page="{{ entityencode(join('-', ctx.request_path), true) }}">

	<div class="liuli-bg" aria-hidden="true">
		<div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div>
		<div class="blob b4"></div><div class="blob b5"></div>
	</div>

	<div class="liuli-app">
		<aside class="liuli-sidenav" id="mainmenu">
			<div class="brand">
				<div class="mark">
					<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
						<path d="M12 2.5 4.5 7v10L12 21.5 19.5 17V7L12 2.5Z"/>
						<path d="M12 12 4.5 7M12 12l7.5-5M12 12v9.5"/>
					</svg>
				</div>
				<div>
					<div class="name">{{ hostname }}</div>
					<div class="sub">琉璃 Liuli{{ distver ? ` · ${distver}` : '' }}</div>
				</div>
			</div>
			<div class="liuli-nav" id="liuli-nav"></div>
			<button type="button" class="liuli-collapse" id="liuli-collapse"
				title="收起 / 展开侧栏" aria-label="收起或展开侧栏">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
					<path d="M14.5 8.5 10 12l4.5 3.5"/>
					<path d="M4 5v14"/>
				</svg>
				<span class="t">收起侧栏</span>
			</button>
		</aside>

		<div class="liuli-main">
			<header class="liuli-topbar">
				<button type="button" class="liuli-menubtn" aria-label="Toggle navigation"
					onclick="document.getElementById('mainmenu').classList.toggle('open')">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
				</button>
				<a class="brand" href="{{ dispatcher.build_url('admin/status/overview') }}" title="{{ entityencode(hostname, true) }}">
					<div class="mark">
						<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 2.5 4.5 7v10L12 21.5 19.5 17V7L12 2.5Z"/>
							<path d="M12 12 4.5 7M12 12l7.5-5M12 12v9.5"/>
						</svg>
					</div>
					<div><b>{{ hostname }}</b><small>{{ model }}</small></div>
				</a>

				<div class="liuli-chips">
					<span class="liuli-chip" id="liuli-chip-clients" title="在线客户端">
						<span class="dot"></span><span class="lbl">在线设备</span> <b id="liuli-clients">—</b>
					</span>
					<span class="liuli-chip" title="运行时间">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
						运行 <b>{{ uptime_str }}</b>
					</span>
					<span class="liuli-chip optional" title="CPU 使用率">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/></svg>
						CPU <b id="liuli-cpu">—</b>
					</span>
					<span class="liuli-chip optional" title="SoC 温度" id="liuli-chip-temp">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 14.76V4a2 2 0 1 0-4 0v10.76a4.5 4.5 0 1 0 4 0Z"/></svg>
						<b id="liuli-temp">—</b>
					</span>
					<span class="liuli-chip traffic" id="liuli-chip-traffic" title="实时流量">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v10M12 4l-3.5 3.5M12 4l3.5 3.5"/><path d="M12 20v-6M12 20l-3.5-3.5M12 20l3.5-3.5"/></svg>
						<span id="liuli-rates">—</span>
						<canvas class="liuli-spark" id="liuli-spark" width="184" height="44"></canvas>
					</span>
				<span class="liuli-chip liuli-clock" id="liuli-clock" title="当前时间">--:--:--</span>
				<button type="button" class="liuli-chip liuli-themebtn" data-liuli-toggle
					onclick="window.liuliThemeToggle(event)">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="4.2"/>
						<path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6"/>
					</svg>
					<span class="liuli-theme-label">自动</span>
				</button>
				<div id="indicators"></div>
				</div>
			</header>

			<main class="liuli-content">
				<div id="maincontent">
					{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
					<div class="alert-message warning">
						<h4>! 未设置密码</h4>
						<p>当前路由器没有设置管理密码, 请尽快配置 root 密码以保护 Web 界面。</p>
						{% if (dispatcher.lookup("admin/system/admin")): %}
						<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">前往密码设置…</a></div>
						{% endif %}
					</div>
					{% endif %}

					{% if (boardinfo?.rootfs_type == "initramfs"): %}
					<div class="alert-message warning">
						<h4>!  Recovery (initramfs) 模式</h4>
						<p>系统正运行在恢复模式, 所有设置修改在重启后都会丢失。此模式仅用于安装固件升级。</p>
						{% if (dispatcher.lookup("admin/system/flash")): %}
						<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">前往固件升级…</a></div>
						{% endif %}
					</div>
					{% endif %}

					<noscript>
						<div class="alert-message warning">
							<h4>! 需要 JavaScript</h4>
							<p>请启用浏览器的 JavaScript, 否则 LuCI 无法正常工作。</p>
						</div>
					</noscript>

					<div id="tabmenu" style="display:none"></div>
